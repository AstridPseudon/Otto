{
  "policy_revision": "evidence-provenance.v1",
  "host_contract": "herzchen.evidence.host.v1",
  "document_role": "evidence.managed",
  "managed_operations": ["dat.evidence.capture", "dat.evidence.version", "dat.evidence.checkin"],
  "lifecycle_operations": ["dat.evidence.reclaim.preview", "dat.evidence.reclaim.apply"],
  "lifecycle_selector": "project-scoped historical exact pins",
  "tombstone_kind": "dat.evidence.tombstone",
  "automatic_deletion": false,
  "upgrade_non_retroactive": true,
  "disable_preserves_data": true,
  "required_origin_bindings": ["project_ref"],
  "optional_origin_bindings": ["task_ref", "attempt_ref"],
  "attribution": ["original_creator", "submitter", "maintainer"],
  "authenticated_facts": ["byte_digest", "byte_length", "format", "capture", "origin"],
  "policy_cannot_grant_actor_authority": true,
  "policy_cannot_overwrite_authenticated_facts": true
}
