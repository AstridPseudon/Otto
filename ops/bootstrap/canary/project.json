{
  "name": "perch-canary",
  "check": "{python} -m unittest discover -q -s tests -t .",
  "pool_limit": 1,
  "stages": {
    "0": {
      "tasks": ["canary-add-sub", "canary-refused"],
      "store": {"store_events": 0, "store_tasks": 0, "store_bytes_max": 262144},
      "scenarios": ["staging-lifecycle"],
      "wipe": true
    },
    "1": {
      "tasks": [],
      "host": "claude-code",
      "store": {"store_events": 3, "store_tasks": 1, "store_bytes_max": 262144, "rows_per_save_max": 50},
      "scenarios": ["save-through-socket"],
      "saves": {
        "create": {
          "project": {"title": "Canary plan", "outcome": "One creation route"},
          "tasks": [
            {"id": "A", "title": "Plan A", "instructions": "Do A", "acceptance": "Done A", "metadata_namespace": {"otto.plan": {"route": "normal", "size": 0.25, "lines": 20}}},
            {"id": "B", "title": "Plan B", "instructions": "Do B", "acceptance": "Done B", "dependencies": ["A"], "metadata_namespace": {"otto.plan": {"route": "normal", "size": 0.5, "lines": 30}}},
            {"id": "C", "title": "Plan C", "instructions": "Do C", "acceptance": "Done C", "metadata_namespace": {"otto.plan": {"route": "normal", "size": 0.25, "lines": 15}}}
          ]
        },
        "edit": {
          "project": {"title": "Canary plan", "outcome": "One creation route"},
          "tasks": [
            {"id": "A", "title": "Plan A edited", "instructions": "Do A", "acceptance": "Done A", "metadata_namespace": {"otto.plan": {"route": "normal", "size": 0.25, "lines": 20}}},
            {"id": "B", "title": "Plan B", "instructions": "Do B", "acceptance": "Done B", "dependencies": ["A"], "metadata_namespace": {"otto.plan": {"route": "normal", "size": 0.75, "lines": 30}}},
            {"id": "C", "title": "Plan C", "instructions": "Do C", "acceptance": "Done C", "dependencies": ["B"], "metadata_namespace": {"otto.plan": {"route": "normal", "size": 0.25, "lines": 15}}}
          ]
        },
        "stale": {
          "project": {"title": "Canary plan", "outcome": "One creation route"},
          "tasks": [
            {"id": "A", "title": "Plan A stale", "instructions": "Do A", "acceptance": "Done A", "metadata_namespace": {"otto.plan": {"route": "normal", "size": 0.25, "lines": 20}}},
            {"id": "B", "title": "Plan B", "instructions": "Do B", "acceptance": "Done B", "dependencies": ["A"], "metadata_namespace": {"otto.plan": {"route": "normal", "size": 0.5, "lines": 30}}},
            {"id": "C", "title": "Plan C", "instructions": "Do C", "acceptance": "Done C", "metadata_namespace": {"otto.plan": {"route": "normal", "size": 0.25, "lines": 15}}}
          ]
        }
      },
      "wipe": true
    },
    "2": {
      "tasks": ["A", "B", "C"],
      "host": "claude-code",
      "repository": "toy",
      "branch": "canon/main",
      "pool_limit": 2,
      "manager_reserve": 1,
      "store": {"store_events_min": 6, "store_work_tasks": ["A", "B", "C"],
                "store_assignment_tasks_min": 3, "store_growth_max": 2097152},
      "scenarios": ["admit-and-dispatch"],
      "run_policy": {
        "assessment_accounting": {
          "kind": "owner_local_bookkeeping",
          "purpose": "Canary check-accepted dispatch evidence",
          "local_only": true,
          "pool_id": "perch-stage2-checks",
          "capacity_units": 1,
          "cumulative_allowance_units": 3,
          "scope_mode": "check-accepted",
          "task_criterion_pairs": ["A/C-A", "B/C-B", "C/C-C"]
        }
      },
      "admission": {"admitted": ["A", "B", "C"],
        "unadmitted_revision": {"task": "C", "revision": "rev-unadmitted", "admitted": false}},
      "dependencies": {"A": [], "B": ["A"], "C": ["B"]},
      "wipe": true
    }
  },
  "tasks": {
    "canary-add-sub": {
      "expect": "landed",
      "turns": [
        {"path": "toy/mathx.py", "append": "\n\ndef sub(a, b):\n    return a - b\n"},
        {"path": "tests/test_mathx.py", "append": "\n\nclass SubTests(unittest.TestCase):\n    def test_sub(self):\n        self.assertEqual(mathx.sub(5, 2), 3)\n"}
      ]
    },
    "canary-refused": {
      "expect": "refused",
      "turns": [
        {"path": "toy/mathx.py", "replace": ["return a + b", "return a - b"]}
      ]
    }
  }
}
