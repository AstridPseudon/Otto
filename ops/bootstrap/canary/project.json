  "tasks": {
    "canary-add-sub": {
      "expect": "landed",
      "turns": [
        {"path": "toy/mathx.py", "append": "\n\ndef sub(a, b):\n    return a - b\n"},
        {"path": "tests/test_mathx.py", "append": "\n\nclass SubTests(unittest.TestCase):\n    def test_sub(self):\n        self.assertEqual(mathx.sub(5, 2), 3)\n"}
      ]
    },
    "canary-refused": {
      "expect": "refused",
      "turns": [
        {"path": "toy/mathx.py", "replace": ["return a + b", "return a - b"]}
      ]
    },
    "canary-stage4-happy": {
      "expect": "landed",
      "turns": [
        {"path": "toy/mathx.py", "append": "\n\ndef stage4_happy():\n    return 'landed'\n"},
        {"path": "tests/test_mathx.py", "append": "\n\nclass Stage4HappyTests(unittest.TestCase):\n    def test_stage4_happy(self):\n        self.assertEqual(mathx.stage4_happy(), 'landed')\n"}
      ]
    },
    "canary-stage4-conflict": {
      "expect": "conflict",
      "landing_conflict": true,
      "turns": [
        {"path": "toy/mathx.py", "replace": ["STAGE4_CONFLICT_SLOT = \"base\"", "STAGE4_CONFLICT_SLOT = \"worker\""]}
      ]
    }
  }
}
