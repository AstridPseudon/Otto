          "tasks": [{"id": "A", "title": "Plan A", "instructions": "Do A", "acceptance": "Done A"}]
        },
        "edit": {
          "project": {"title": "Canary plan", "outcome": "One creation route"},
          "tasks": [{"id": "A", "title": "Plan A two", "instructions": "Do A", "acceptance": "Done A"}]
        },
        "stale": {
          "project": {"title": "Canary plan", "outcome": "One creation route"},
          "tasks": [{"id": "A", "title": "Plan A three", "instructions": "Do A", "acceptance": "Done A"}]
        }
      },
