      "tasks": ["A", "B", "C"],
      "host": "claude-code",
      "repository": "toy",
      "branch": "canon/main",
      "pool_limit": 4,
      "manager_reserve": 1,
      "capacity": {"turn_units": 4, "manager_reserve": 1,
                   "heavy_headroom": 3, "worker_floor": 1},
      "store": {"store_events_min": 6, "store_work_tasks": ["A", "B", "C"],
                "store_assignment_tasks_min": 3, "store_growth_max": 2097152},
      "scenarios": ["owner-driven-canary"],
      "run_policy": {
        "assessment_accounting": {
          "kind": "owner_local_bookkeeping",
          "purpose": "Canary check-accepted dispatch evidence",
          "local_only": true,
          "pool_id": "perch-stage3-checks",
          "capacity_units": 3,
